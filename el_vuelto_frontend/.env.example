# Normally you do NOT need this file: the app calls the API at the relative
# path /api, and nginx (or the Vite dev proxy) routes it to Django on the same
# origin. That is what removes CORS and keeps the LAN IP out of the bundle.
#
# Set VITE_API_URL only to point at a backend on a genuinely different origin
# (e.g. a staging server). Leaving it unset is the correct default.
# VITE_API_URL=/api

VITE_APP_NAME=El Vuelto
