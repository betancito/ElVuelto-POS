# ═════════════════════════════════════════════════════════════════════════════
# ElVuelto — Docker stack configuration
#
#   cp .env.example .env
#
# This file configures the CONTAINERS. The Django app keeps its own secrets in
# el_vuelto_backend/.env (SECRET_KEY, Cloudinary, DOCS_API_KEY) — that file is
# loaded into the backend container as-is, so there is no need to duplicate it
# here. Anything set below wins over it.
#
# Never commit .env. This example file carries no real values.
# ═════════════════════════════════════════════════════════════════════════════

# ── Published ports ──────────────────────────────────────────────────────────
# nginx is the only service that publishes anything. These are deliberately the
# same numbers the services use inside Docker, so a port means one thing only.

# The application: SPA + API on a single origin. THIS is the URL you open on
# the phone (http://<mac-lan-ip>:5173). Same-origin is what removes CORS.
APP_PORT=5173

# The backend, straight through — curl, Postman, /docs/, Django admin.
API_PORT=8000

# Interface nginx binds to on the host. 0.0.0.0 = every interface, which is
# what makes the LAN (your phone) able to reach it.
# Set 127.0.0.1 ONLY if you put your own nginx on the host in front of this
# stack — then that nginx owns 0.0.0.0 and the containers stay private.
BIND_HOST=0.0.0.0


# ── Database ─────────────────────────────────────────────────────────────────
# There is no `db` service in this stack: Postgres already runs as a container
# outside it, publishing 5432 on the host, and holds the live `elvuelto`
# database. host.docker.internal is how a container reaches the Mac.
#
# For a deployment, point this at the managed instance and change nothing else.
# The remaining DB_* values (DB_NAME, DB_USER, DB_PASSWORD) come from
# el_vuelto_backend/.env.
DB_HOST=host.docker.internal
DB_PORT=5432


# ── Django host validation ───────────────────────────────────────────────────
# ALLOWED_HOSTS is only read by settings/production.py; settings/local.py
# hardcodes ["*"], which is what dev uses.
# Comma-separated. Must include the Mac's LAN IP for prod on the LAN.
ALLOWED_HOSTS=localhost,127.0.0.1,backend
# OJO: docker-compose.yml:49 declara `ALLOWED_HOSTS: ${ALLOWED_HOSTS:-*}`. Si
# borrás esta línea, el default NO es el de production.py: es `*`, o sea
# validación de host apagada. En un deploy público poné el dominio, siempre.
#   ALLOWED_HOSTS=pos.midominio.co

# THE ONE PEOPLE FORGET. Without the LAN origin listed here, logging into the
# Django admin from another device returns 403 "CSRF verification failed" —
# and so does every POST. Comma-separated, and the scheme AND port are both
# required: `http://192.168.1.75:5173`, not `192.168.1.75`.
# Find the IP with: ipconfig getifaddr en0
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# django-cors-headers is still installed and configured, but with the SPA and
# the API on one origin it no longer has anything to do — the proxy is what
# actually solves the LAN case. Kept for direct API clients on other origins.
CORS_ALLOWED_ORIGINS=http://localhost:5173


# ── Image naming (so a CI job can push these later) ───────────────────────────
# Produces elvuelto-backend:dev, elvuelto-frontend:dev, elvuelto-nginx:prod, …
IMAGE_PREFIX=elvuelto
# Leave TAG UNSET. Each environment then supplies its own default — dev builds
# elvuelto-backend:dev, prod builds elvuelto-backend:prod. Pinning it here
# applies to BOTH, so a `build prod` would overwrite your dev images.
# Set it only for a real release:
#   TAG=$(git rev-parse --short HEAD) ./scripts/manage-docker.sh build prod
# TAG=


# ── Deploy público con dominio y HTTPS ───────────────────────────────────────
# APAGADO por defecto, a propósito: el mismo `up prod` se usa para correr en la
# LAN por HTTP, y ahí SECURE_SSL_REDIRECT dejaría la app inalcanzable.
# Prendelo SOLO cuando haya dominio y TLS en el borde (Caddy / App Gateway).
# Activa: SECURE_SSL_REDIRECT, SESSION_COOKIE_SECURE, CSRF_COOKIE_SECURE y
# SECURE_PROXY_SSL_HEADER. Ver settings/production.py.
# SECURE_SSL=1

# HSTS: dejalo en 0 hasta CONFIRMAR que el dominio sirve bien por https. Una
# vez que un navegador lo cachea no hay vuelta atrás del lado del servidor.
# Después: 3600 un día, y si todo va bien, 31536000.
# SECURE_HSTS_SECONDS=0

# Azure Database for PostgreSQL EXIGE TLS. En un deploy gestionado poné
# `require`: la conexión falla si no hay TLS, en vez de caer a texto plano.
# DB_SSLMODE=require

# El borde TLS (servicio `caddy`, perfil `edge` en docker-compose.prod.yml).
# Sin estas dos el perfil `edge` no arranca: el compose las declara con `:?`.
# El dominio va SIN esquema y tiene que ser EXACTAMENTE el del registro A.
# DOMAIN=pos.midominio.co
# ACME_EMAIL=vos@midominio.co
#
# Y con dominio, BIND_HOST tiene que bajar a loopback (arriba, línea de
# BIND_HOST): con 0.0.0.0 los puertos 5173 y 8000 siguen escuchando en la IP
# pública de la VM, y nginx RESPETA el X-Forwarded-Proto que le manden — o sea
# que cualquiera puede hacerle creer a Django que una request en texto plano
# llegó por TLS. Runbook completo: docs/azure-deploy.md.
#   BIND_HOST=127.0.0.1


# ── Production only ──────────────────────────────────────────────────────────
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=60

# DRF counts login throttling in the cache. With several gunicorn workers and
# the default LocMemCache, each worker keeps its OWN counter, so every rate
# limit in settings/base.py is silently multiplied by the worker count. Set a
# Redis URL to make them share one — and add `redis` to requirements.txt, it is
# deliberately not there (see the note in settings/base.py).
# REDIS_URL=redis://host.docker.internal:6379/0
